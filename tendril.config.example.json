{
  "host": "127.0.0.1",
  "port": 3210,
  "browserBackend": "obscura",
  "obscuraStealth": true,
  "headless": true,
  "maxSessions": 4,
  "sessionIdleMs": 600000,
  "actionTimeoutMs": 30000,
  "navigationTimeoutMs": 60000,
  "maxSnapshotChars": 20000,
  "maxResponseBodyBytes": 2097152,
  "blockPrivateNetworks": true,
  "allowedHosts": ["localhost"],
  "blockedHosts": [],
  "workspaceRoots": ["."],
  "searchProviders": ["searxng", "duckduckgo", "bing"],
  "searxngUrl": "http://localhost:8080"
}
